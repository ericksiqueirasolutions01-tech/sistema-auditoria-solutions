# ==============================================================================
# SISTEMA DE AUDITORIA SOLUTIONS - SAMSUNG
# MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# NUNCA insira senhas reais, tokens ou chaves de serviço de produção neste arquivo.
# ==============================================================================

# Identificação e Versão do Aplicativo
VITE_APP_TITLE="SISTEMA DE AUDITORIA GRUPO SOLUTIONS - SAMSUNG"
VITE_APP_VERSION="1.2.0"

# Endpoint da API Central de Sincronização
# Em ambiente local: http://localhost:3000
# Em staging: https://staging-api.auditoria.solutions.internal
# Em produção: https://api.auditoria.solutions.com.br
VITE_CENTRAL_API_URL="http://localhost:3000"

# Porta Local do Servidor de Bipagem Desktop
VITE_DESKTOP_LOCAL_PORT=3000

# Timeout de Requisições de Rede (milissegundos)
VITE_NETWORK_TIMEOUT_MS=15000

# Retenção Máxima da Fila de Outbox Local (dias)
VITE_OUTBOX_RETENTION_DAYS=30

# Nível de Log do Sistema (DEBUG | INFO | WARN | ERROR)
VITE_LOG_LEVEL="INFO"

