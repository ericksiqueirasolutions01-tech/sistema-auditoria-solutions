# ==============================================================================
# SISTEMA DE AUDITORIA SOLUTIONS - SAMSUNG
# VARIÁVEIS DE AMBIENTE (SUPABASE & SEGURANÇA)
# ==============================================================================

# 1. Configuração Pública do Frontend (Vite)
# Apenas a URL do projeto e a chave anônima (pública) são permitidas no cliente.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# 2. Configuração Privada do Backend (Vercel Serverless Functions)
# Chave privilegiada para operações backend no servidor. NUNCA exponha no navegador.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVER_SECRET=sua-chave-privada-do-servidor-aqui

# 3. Segredo para Operações Administrativas Destrutivas (Limpeza e Reset)
ADMIN_CLEANUP_SECRET=chave-secreta-administrativa-forte-aqui
